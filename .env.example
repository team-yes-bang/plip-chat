# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)

# 앱 포트 (호스트에 노출)
SERVER_PORT=8080

# Kafka (user / develop-env 공통). Docker 네트워크에서는 kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Mongo replica set rs0 (Docker 네트워크에서는 mongo:27017). develop-env 복사 시 동일 URI 호스트 `mongo`
MONGODB_URI=mongodb://localhost:27017/plip_chat?replicaSet=rs0
MONGODB_PORT=27017

# Redis. Docker 네트워크에서는 redis
REDIS_HOST=localhost
REDIS_PORT=6379
